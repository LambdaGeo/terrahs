cabal-version:      3.0
name:               terrahs
version:            0.1.0.0
synopsis:           A pure Haskell environment for geospatial programming
description:
    TerraHS is a Haskell library for building geographical applications in a
    purely functional style. This is a from-scratch rewrite of the original
    TerraHS (2006-2009), which depended on the C++ TerraLib. This version has
    no FFI / no C library dependencies: geometry, topology, and map algebra
    are implemented in plain Haskell, both as a research tool and as
    teaching material for functional programming. The I/O layer (WKT, GeoJSON,
    Shapefile) uses only well-established pure-Haskell libraries.
license:            GPL-3.0-only
license-file:       LICENSE
author:             Sergio Costa
maintainer:         skosta@gmail.com
category:           Geography
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wredundant-constraints

library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010
    exposed-modules:
        TerraHS
        TerraHS.Geometry
        TerraHS.Geometry.Coord
        TerraHS.Geometry.Point
        TerraHS.Geometry.Line
        TerraHS.Geometry.Polygon
        TerraHS.Geometry.BBox
        TerraHS.Geometry.Any
        TerraHS.Geometry.Topology
        TerraHS.Geometry.Simplify
        TerraHS.IO.WKT
        TerraHS.IO.GeoJSON
        TerraHS.IO.Shapefile
        TerraHS.IO.Dbf
        TerraHS.IO.Vector
        TerraHS.Algebra.Coverage
        TerraHS.Algebra.Funct
        TerraHS.Algebra.Field
    build-depends:
        base       >= 4.14 && < 5,
        aeson      >= 2.0  && < 3,
        binary     >= 0.8.4 && < 1,
        bytestring >= 0.10 && < 1,
        text       >= 1.2  && < 3,
        filepath   >= 1.4  && < 2

-- A second, optional library: PNG rendering for Coverage values and
-- grids (see render/TerraHS/Render/PNG.hs for why this isn't folded
-- into the main library). Anything that wants PNG output depends on
-- terrahs-render explicitly; reading a shapefile or running the
-- algebra alone never pulls in JuicyPixels.
library terrahs-render
    import:           warnings
    hs-source-dirs:   render
    default-language: Haskell2010
    exposed-modules:
        TerraHS.Render.PNG
    build-depends:
        base        >= 4.14 && < 5,
        JuicyPixels >= 3.3  && < 4,
        terrahs

-- A third library: a tiny generic cellular-automaton machine
-- (neighbourhoods + time stepping over Control.Comonad.Store), kept
-- out of the core library for the same reason as terrahs-render --
-- it depends on comonad/contravariant, which most uses of TerraHS
-- have no reason to carry.
library terrahs-ca
    import:           warnings
    hs-source-dirs:   ca
    default-language: Haskell2010
    exposed-modules:
        TerraHS.CA
    build-depends:
        base          >= 4.14 && < 5,
        comonad       >= 5    && < 6,
        contravariant >= 1.5  && < 2

test-suite terrahs-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    default-language: Haskell2010
    build-depends:
        base >= 4.14 && < 5,
        terrahs

executable terrahs-demo
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    other-modules:    Synthetic
    default-language: Haskell2010
    build-depends:
        base   >= 4.14 && < 5,
        random >= 1.1  && < 1.3,
        terrahs

-- Worked examples beyond the flagship terrahs-demo, each self-contained
-- under examples/<name>/ (source data shared from examples/data/). See
-- examples/README.md for what each one covers.

executable geojoin-demo
    import:           warnings
    hs-source-dirs:   examples/geojoin-demo
    main-is:          Main.hs
    default-language: Haskell2010
    build-depends:
        base >= 4.14 && < 5,
        terrahs

executable road-city-join-demo
    import:           warnings
    hs-source-dirs:   examples/road-city-join-demo
    main-is:          Main.hs
    default-language: Haskell2010
    build-depends:
        base >= 4.14 && < 5,
        terrahs

executable ibge-road-join-demo
    import:           warnings
    hs-source-dirs:   examples/ibge-road-join-demo
    main-is:          Main.hs
    default-language: Haskell2010
    build-depends:
        base >= 4.14 && < 5,
        terrahs

executable life-demo
    import:           warnings
    hs-source-dirs:   examples/life-demo
    main-is:          Main.hs
    default-language: Haskell2010
    build-depends:
        base          >= 4.14 && < 5,
        comonad       >= 5    && < 6,
        directory     >= 1.3  && < 2,
        terrahs-ca,
        terrahs-render

executable diffusion-demo
    import:           warnings
    hs-source-dirs:   examples/diffusion-demo, examples/common
    main-is:          Main.hs
    other-modules:    StoreBridge, ZoneWorld
    default-language: Haskell2010
    build-depends:
        base          >= 4.14 && < 5,
        comonad       >= 5    && < 6,
        contravariant >= 1.5 && < 2,
        directory     >= 1.3  && < 2,
        terrahs,
        terrahs-ca,
        terrahs-render

executable fire-demo
    import:           warnings
    hs-source-dirs:   examples/fire-demo, examples/common
    main-is:          Main.hs
    other-modules:    ZoneWorld
    default-language: Haskell2010
    build-depends:
        base          >= 4.14 && < 5,
        comonad       >= 5    && < 6,
        contravariant >= 1.5 && < 2,
        directory     >= 1.3  && < 2,
        terrahs,
        terrahs-ca,
        terrahs-render

executable ibge-map-demo
    import:           warnings
    hs-source-dirs:   examples/ibge-map-demo
    main-is:          Main.hs
    default-language: Haskell2010
    build-depends:
        base      >= 4.14 && < 5,
        directory >= 1.3  && < 2,
        terrahs,
        terrahs-render
